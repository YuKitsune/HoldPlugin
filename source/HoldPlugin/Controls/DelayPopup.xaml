<UserControl x:Class="HoldPlugin.Controls.DelayPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:toolbox="clr-namespace:vatSysToolbox;assembly=vatSysToolbox"
             xmlns:viewModels="clr-namespace:HoldPlugin.ViewModels"
             Background="{toolbox:VatSysColour WindowBackground}"
             d:DataContext="{d:DesignInstance Type=viewModels:DelayPopupViewModel}"
             mc:Ignorable="d"
             Height="64"
             Width="Auto">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Width" Value="104"/>
                <Setter Property="Height" Value="24"/>
            </Style>
            
            <Style TargetType="TextBlock" BasedOn="{StaticResource GenericTextStyle}" />
            
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="2" BorderBrush="{toolbox:VatSysColour GenericText}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Text="{Binding WaypointName}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Margin="8,0">DLA</TextBlock>
            <TextBox x:Name="DelayDurationTextBox"
                     Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="40" Margin="8,0" MaxLength="4"
                     Text="{Binding DelayDuration, UpdateSourceTrigger=PropertyChanged}"
                     PreviewTextInput="DelayDurationTextBox_PreviewTextInput"
                     PreviewKeyDown="DelayDurationTextBox_PreviewKeyDown"
                     DataObject.Pasting="DelayDurationTextBox_Pasting" />
        </Grid>
    </Border>
</UserControl>
